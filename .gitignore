# given data — never committed
dataset/

# caches and heavy intermediates
artifacts/*
!artifacts/.gitkeep

# submission outputs: the raw TSVs are regenerated by the pipeline, but the gzipped
# scored file is committed so a Kaggle run's predictions come back with git pull.
output/*.tsv
!output/*.tsv.gz

# environment
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# macOS
.DS_Store
